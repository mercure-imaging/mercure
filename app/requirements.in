# Security floors for transitive dependencies. These are not imported directly; the floor exists
# because the advisory-fixed release is only reachable by forcing the version (pip-compile keeps an
# already-pinned transitive version otherwise). Remove one once the parent package requires it.
anyio >= 4.14.2        # via starlette, uvicorn  (CVE-2026-63374 critical, CVE-2026-64847)
idna >= 3.15           # via requests, aiohttp   (CVE-2026-45409)
pygments >= 2.20.0     # via pytest              (CVE-2026-4539)
